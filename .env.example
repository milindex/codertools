# CoderTools analytics
#
# If NEXT_PUBLIC_SUPABASE_URL is set, the function URLs are derived
# automatically:
#   <url>/functions/v1/codertools-track
#   <url>/functions/v1/codertools-analytics
# Override them explicitly if the functions live elsewhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_TRACK_URL=https://your-project.supabase.co/functions/v1/codertools-track
NEXT_PUBLIC_SUPABASE_ANALYTICS_URL=https://your-project.supabase.co/functions/v1/codertools-analytics

# Database password for the Supabase CLI (migrations only; never exposed to the
# browser). Use it with `supabase db push --password "$SB_PASSWORD"` or set
# SUPABASE_DB_PASSWORD from it.
SB_PASSWORD=your-database-password

# Read server-side by functions/api/track.js (Cloudflare Pages Function) so the
# country can be stamped from CF-IPCountry. Also used by the client as a dev
# fallback when /api/track is unavailable.
SUPABASE_TRACK_URL=https://your-project.supabase.co/functions/v1/codertools-track

# Set to true only if you want to track localhost traffic during development.
NEXT_PUBLIC_ANALYTICS_DEBUG=false